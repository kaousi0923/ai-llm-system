# API Keys and Tokens
OPENAI_API_KEY=your_openai_api_key_here
HF_TOKEN=your_huggingface_token_here
AUTHORIZATION_TOKEN=Bearer_your_token_here

# Model Configuration
LLM_API_URL=http://127.0.0.1:3000/ollama/api/chat
LLM_MODEL_PATH=path_to_your_model
DEFAULT_PROMPT_TEMPLATE=你是一個客服助理，你根據系統搜索的內容擷取有用的部分回覆使用者問題
MAX_SEQ_LENGTH=2048

# Available Models (comma-separated)
BASE_MODELS=chatgpt-4o-latest,gpt-4o-mini,gpt-4.1,unsloth/gemma-3-4b-it,unsloth/gemma-3-1b-it
PAYMENT_MODELS=chatgpt-4o-latest,gpt-4o-mini,gpt-4.1

# Directory Configuration
LOGS_DIR=logs
VECTOR_DBS_DIR=vector_dbs
CHAT_HISTORY_DIR=chat_history
TEMP_DIR=temp_files
TRAINED_MODELS_DIR=trained_models
BASE_MODELS_DIR=base_models

# Embedding API Defaults
EMBED_MODEL=intfloat/multilingual-e5-base
EMBED_SUMMARIZER=
EMBED_TEXT_SPLITTER=Recursive
EMBED_CHUNK_SIZE=1500
EMBED_CHUNK_OVERLAP=100
EMBED_SUMMARY_THRESHOLD=100000

# Chat API Defaults
CHAT_MODEL=chatgpt-4o-latest
CHAT_TEMPLATE=
CHAT_TEMPERATURE=0.1
CHAT_TOP_P=0.1
CHAT_MAX_TOKENS=2048
CHAT_HISTORY_LENGTH=3
CHAT_RETRIEVAL_K=0.5
CHAT_DROPOUT=0.05

# Tunnel Configuration (Optional)
TUNNEL_PORT=5000

# Python Environment Settings
PYTHONUTF8=1
DISABLE_TORCH_INDUCTOR=1
TORCHINDUCTOR_DISABLE=1
TORCH_COMPILE=0
HF_HUB_ENABLE_HF_TRANSFER=0

# Hugging Face Cache Directory
HUGGINGFACE_HUB_CACHE=./base_models